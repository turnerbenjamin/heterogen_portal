{{- define "main-table-content"}}
<main>
    <div class="sidebar expanded" id="column-editor">
        <div id="sidebar-title">
            <h3>Edit Columns</h3>
            <div id="close-sidebar" class="icon large interactive" onclick="closeSidebar(e)">{{.Icons.XMark}}</div>
        </div>
        {{- range $index, $header := .Data.TableHeader}}
            <div draggable="true">{{$header.Column.DisplayName}}</div>
        {{- end}}
        <button>apply</button>
    </div>
    <div class="sidebar" id="column-selector">
        {{- range $index, $column := .Data.ColumnDefinitions}}
        <div class="column-option-group">
            <input type="checkbox" id="column-selector-{{$column.DisplayName}}" name="{{$column.DisplayName}}" value="{{$column.DisplayName}}"/>
            <label for="column-selector-{{$column.DisplayName}}">{{$column.DisplayName}}</label>
        </div>
        {{- end}}
        <button>add</button>
    </div>
    <div class="main-table-head">
        <h3>{{ .Data.TableName}}</h3>
        <div class="main-table-cmd">
            <div>Edit Columns</div>
            <div>Edit Filters</div>
            <input type=text/>
        </div>
    </div>
    <table class="main-table mt-6"> 
        <thead>
            <tr>
            {{- range $index, $header := .Data.TableHeader}}
                <td>{{$header.Column.DisplayName}}</td>
            {{- end}}
            </tr>
        </thead>
        <tbody>
        {{- range $rowIndex, $row := .Data.Rows }}
            <tr>
            {{- range $columnIndex, $header := $.Data.TableHeader }}
                <td>{{ call $header.Column.GetData $row }}</td>
            {{- end }}
            </tr>
        {{- end }}
        </tbody>
    </table>
</main>
{{- end}}
