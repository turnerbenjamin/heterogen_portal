{{- define "main-table-content"}}
<main>
  <h3>{{ .Data.TableName}}</h1>
    <table data-schema-version={{.Data.SchemaVersion}} data-cols="{{- range $index, $column := .Data.ColumnDefinitions}}{{if $index}};{{end}}{{$column.ColumnName}}:{{$column.DisplayName}}:{{$column.DataType}}{{if $column.Path}}:{{$column.Path}}{{end}}{{- end}}">
        <thead>
            <tr>
            {{- range $index, $header := .Data.TableHeader}}
                <td>{{$header.Column.DisplayName}}</td>
            {{- end}}
            </tr>
        </thead>
        <tbody>
        {{- range $rowIndex, $row := .Data.Rows }}
            <tr>
            {{- range $columnIndex, $header := $.Data.TableHeader }}
                <td>{{ call $header.Column.GetData $row }}</td>
            {{- end }}
            </tr>
        {{- end }}
        </tbody>
    </table>
</main>
{{- end}}
