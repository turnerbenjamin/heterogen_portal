package components

import "github.com/turnerbenjamin/heterogen_portal/internal/templates"

type AlertData struct{
	Title string
	Message string
}

templ Alert(
	pageConfig templates.PageConfig,
	data AlertData,
) {
	if pageConfig.ContentOnly{
		<div hx-swap-oob="outerHTML:#alert">
				@alertContent(data)
		</div>
	}else{
		<div id="alert-layer">
			<template id="alert_template">
				@alertTemplate(AlertData{})
			</template>
			@alertContent(data)
		</div>
	}
} 

templ alertContent(data AlertData){
	if data.Title != "" && data.Message !=""{
		@alertTemplate(data)
	}
}

templ alertTemplate(
	data AlertData,
){
<div 
	id="alert" 
  role="alertdialog"
	aria-modal="true" 
	aria-labelledby="alert-title"
	aria-describedby="alert-message"
>
	<h2 id="alert-title">{data.Title}</h2>
	<p id="alert-message">{data.Message}</p>
	<pre id="alert-detail" class="error-detail hidden"></pre>
	<div id="alert-controls">
		<button 
			id="alert-accept" 

			initial-focus
			onclick="hg.closeAlert()"
		>
				Ok
		</button>
		<button 
			id="alert-decline"
			onclick="hg.closeAlert()"
		>
			Cancel 
		</button>
	</div>
</div>
}