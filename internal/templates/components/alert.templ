package components

templ Alert() {
	<div id="alert-layer" inert>
		<div id="alert" class="hidden">
			<button onclick="hg.closeAlert()">Close</button>
			<h2 id="alert-title"></h2>
			<p id="alert-message"></p>
			<div id="alert-detail"></div>
			<button id="alert-accept">Ok</button>
			<button id="alert-decline">Cancel</button>
		</div>
	</div>
} 