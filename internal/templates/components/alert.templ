package components

import "github.com/turnerbenjamin/heterogen_portal/internal/templates"

type AlertData struct{
	Title string
	Message string
}

templ Alert(
	pageConfig templates.PageConfig,
	data AlertData,
) {
	if pageConfig.ContentOnly{
				@alertContent(data)
	}else{
		<div id="alert-layer">
			<template id="alert_template">
				@alertTemplate(true)
			</template>
			<div id="alerts">
			@alertContent(data)
			</div>
		</div>
	}
} 

templ alertContent(data AlertData){
	if data.Title != "" && data.Message !=""{
		<div hx-swap-oob="innerHTML:#alerts">
			@alertTemplate(false)
		</div>
	}
}

templ alertTemplate(
	isTemplate bool,
){
<div 
	class="alert" 
	server-error?={!isTemplate}
	aria-live="assertive"
  role="alertdialog"
	aria-modal="true" 
	aria-labelledby="alert-title"
	aria-describedby="alert-message"
>
	<h2 class="alert-title"></h2>
	<p class="alert-message"></p>
	<pre class="error-detail hidden"></pre>
	<div class="alert-controls">
		<button 
			class="alert-accept" 

			initial-focus
			onclick="hg.closeAlert()"
		>
				Ok
		</button>
		<button 
			class="alert-decline"
			onclick="hg.closeAlert()"
		>
			Cancel 
		</button>
	</div>
</div>
}