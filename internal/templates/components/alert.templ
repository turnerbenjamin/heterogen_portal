package components

templ Alert() {
	<div id="alert" class="hidden">
		<div id="alert-dialog">
			<h2 id="alert-title">Title</h2>
			<div id="alert-message">An unexpected error has occured, please fuck off</div>
			<a id="alert-detail-getter">download details</a>
			<button>Ok</button>
		</div>
	</div>
} 