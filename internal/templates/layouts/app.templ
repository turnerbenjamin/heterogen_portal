package layouts

import (
    "github.com/turnerbenjamin/heterogen_portal/internal/templates"
    "github.com/turnerbenjamin/heterogen_portal/internal/templates/components"
	"github.com/turnerbenjamin/heterogen_portal/internal/icons"
)

type Content struct{
    MainContent templ.Component
    SidebarContent templ.Component
    NestedSidebarContent templ.Component
}

templ App(
    pageConfig templates.PageConfig, 
    icons *icons.IconSet,
    content Content,
) {
    if pageConfig.ContentOnly {
        @content.MainContent

        @Sidebar(pageConfig, icons, content.SidebarContent)
        @NestedSidebar(pageConfig, icons, content.NestedSidebarContent)
    }else{
    <!DOCTYPE html>
        <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1">

                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1">
                <meta name="description" content="Seed management tool"/>

                if len(pageConfig.Title) > 0{
                    <title>{pageConfig.Title}</title>
                } else {
                    <title>HETEROGEN</title>
                }

                <link href="/static/css/style.css" rel="stylesheet">
                <link rel="icon" type="image/x-icon" href="/static/images/favicon.ico">
                <script src="/static/js/htmx.min.js" defer></script>
                <script type="module" src="/static/js/scripts/index.js" defer></script>
            </head>
            <body>
                <div id="modal-overlay"></div>
                <div id="toast-container"></div>
                @components.Toast(templates.ToastData{
                    ToastSuccess: pageConfig.ToastSuccess,
                })
                @Sidebar(pageConfig, icons, content.SidebarContent)
                @NestedSidebar(pageConfig, icons, content.NestedSidebarContent)
                @components.Alert()
                <div id="app">
                    <aside id="title-bar">Title</aside>
                    <nav id="nav-bar">
                        <ul>
                            <li 
                                class="hx-anchor" 
                                hx-get="/users" 
                                hx-swap="innerHTML" 
                                hx-target="#page-content"
                                hx-push-url="true"
                                hx-indicator="main"
                            >
                                Users
                            </li>
                            <li 
                                class="hx-anchor" 
                                hx-get="/businesses" 
                                hx-swap="innerHTML" 
                                hx-target="#page-content"
                                hx-push-url="true"
                                hx-indicator="main"
                            >
                                Businesses
                            </li>
                        </ul>
                    </nav>
                    <div id="page-content">
                        @content.MainContent
                    </div>
                </div>
        </body>
    </html>
}
}