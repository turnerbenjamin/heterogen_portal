package layouts

import (
    "github.com/turnerbenjamin/heterogen_portal/internal/templates"
    "github.com/turnerbenjamin/heterogen_portal/internal/templates/components"
)

templ App(
    pageConfig templates.PageConfig, 
    content templ.Component,
) {
    <!DOCTYPE html>
        <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1">

                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1">
                <meta name="description" content="Seed management tool"/>

                if len(pageConfig.Title) > 0{
                    <title>{pageConfig.Title}</title>
                } else {
                    <title>HETEROGEN</title>
                }

                <link href="/static/css/style.css" rel="stylesheet">
                <link rel="icon" type="image/x-icon" href="/static/images/favicon.ico">

                if pageConfig.WebResourceDependencies.HTMX {
                    <script src="/static/js/htmx.min.js" defer></script>
                }
                if pageConfig.WebResourceDependencies.HG_COMMON {
                    <script type="module" src="/static/js/scripts/hgCommon.js" defer></script>
                }
            </head>
            <body>
                <div id="toast-container"></div>
                <aside id="title-bar">Title</aside>
                <nav id="nav-bar">
                    <ul>
                        <li 
                        class="hx-anchor" 
                        hx-get="/users" 
                        hx-swap="innerHTML" 
                        hx-target="#page-content"
                        hx-push-url="true"
                        >
                            Users
                        </li>
                        <li 
                        class="hx-anchor" 
                        hx-get="/businesses" 
                        hx-swap="innerHTML" 
                        hx-target="#page-content"
                        hx-push-url="true"
                        >
                            Businesses
                        </li>
                    </ul>
                </nav>
                <div id="page-content">
                    @components.Toast(templates.ToastData{
                        ToastSuccess: pageConfig.ToastSuccess,
                    })
                    @content
                </div>
        </body>
    </html>
}