package pagecontent

import (
    "github.com/turnerbenjamin/heterogen_portal/internal/templates"
	  "github.com/turnerbenjamin/querystack/querymodel"
	  "github.com/turnerbenjamin/heterogen_portal/internal/icons"
)


templ MainTable[T querymodel.TableModel](
    icons *icons.IconSet,
    tableData templates.TableData[T],
){
    switch tableData.RequestTarget{
        case templates.MainTableRequestTargetTableBody:
            @tableBody(tableData)
        case templates.MainTableRequestTargetTable:
            @table(tableData)
        default:
            @mainTablePageContent(icons, tableData)
    }
}

templ mainTablePageContent[T querymodel.TableModel](
    icons *icons.IconSet,
    tableData templates.TableData[T],
){
    <main id="main-table-content">
        <div class="main-table-head">
            <h3>{tableData.TableName}</h3>
            <div class="main-table-cmd">
                <button 
                    class="button-link"
                    onclick="hg.mainTable.showEditColumnsSidebar()"
                    initial-focus
                >
                    Edit Columns
                </button>
                <button 
                    class="button-link"
                    onclick="hg.mainTable.showEditFiltersSidebar()"
                    initial-focus
                >
                    Edit Filters
                </button>
                <input type=text/>
            </div>
        </div>
        <table id="main-table" class="main-table mt-6"> 
        @table(tableData)
        </table>
    </main>
}

templ table[T querymodel.TableModel](
    tableData templates.TableData[T],
){
    <thead>
        <tr>
        for _, headerColumn := range tableData.Query.SelectCols{
            <th 
                data-column-path={headerColumn.Path}
            >
                {headerColumn.DisplayName}
            </th>
        }
        </tr>
    </thead>
    <tbody id="main-table-body">
        @tableBody(tableData) 
    </tbody>
}

templ tableBody[T querymodel.TableModel](
    tableData templates.TableData[T],
){
for _ , row := range tableData.Rows{
    <tr>
    for _, headerColumn := range tableData.Query.SelectCols{
        <td data-label={headerColumn.DisplayName}>{headerColumn.GetData(row)}</td>
    }
    </tr>
}
}