package pagecontent

import (
	  "github.com/turnerbenjamin/querystack/querymodel"
	  "github.com/turnerbenjamin/heterogen_portal/internal/icons"
	"github.com/turnerbenjamin/heterogen_portal/internal/tables"
	"github.com/turnerbenjamin/heterogen_portal/internal/model"
)


templ MainTable[T querymodel.TableModel](
    tableCellBuilder model.UiTableCellBuilder,
    icons *icons.IconSet,
    tableData tables.TableData[T],
){
    switch tableData.RequestTarget{
        case tables.MainTableRequestTargetTableBody:
            @tableBody(tableCellBuilder, tableData)
        case tables.MainTableRequestTargetTable:
            @table(tableCellBuilder, tableData)
        default:
            @mainTablePageContent(tableCellBuilder, icons, tableData)
    }
}

templ mainTablePageContent[T querymodel.TableModel](
    tableCellBuilder model.UiTableCellBuilder,
    icons *icons.IconSet,
    tableData tables.TableData[T],
){
    <main id="main-table-content">
        <div class="main-table-head">
            <h3>{tableData.TableDefinition.PluralDisplayName}</h3>
            <div class="main-table-cmd">
                <button 
                    class="button-link"
                    onclick="hg.mainTable.showEditColumnsSidebar()"
                    initial-focus
                >
                    Edit Columns
                </button>
                <button 
                    class="button-link"
                    onclick="hg.mainTable.showEditFiltersSidebar()"
                    initial-focus
                >
                    Edit Filters
                </button>
                <input type=text/>
            </div>
        </div>
        <table id="main-table" class="main-table mt-6"> 
        @table(tableCellBuilder, tableData)
        </table>
    </main>
}

templ table[T querymodel.TableModel](
    tableCellBuilder model.UiTableCellBuilder,
    tableData tables.TableData[T],
){
    <thead>
        <tr>
        for _, headerColumn := range tableData.Query.SelectQuery.Columns{
            <th 
                data-column-path={headerColumn.Path}
            >
                {headerColumn.DisplayName}
            </th>
        }
        </tr>
    </thead>
    <tbody id="main-table-body">
        @tableBody(tableCellBuilder, tableData) 
    </tbody>
}

templ tableBody[T querymodel.TableModel](
    tableCellBuilder model.UiTableCellBuilder,
    tableData tables.TableData[T],
){
for _ , row := range tableData.Rows{
    <tr>
    for _, headerColumn := range tableData.Query.SelectQuery.Columns{
        @headerColumn.BuildTableCell(row, tableCellBuilder)
    }
    </tr>
}
}