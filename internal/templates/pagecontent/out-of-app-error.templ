package pagecontent

templ OutOfAppError() {
    <main class="focussed-main">
        <div id="last-ditch-err-container">
            <h1 id="last-ditch-err-title">Server Error</h1>
            <p id="last-ditch-err-message">
                There has been an unexpected error, please try again later.
            </p>
        </div>
    </main>
}