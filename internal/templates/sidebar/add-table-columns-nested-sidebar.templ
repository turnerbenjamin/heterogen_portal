package sidebar

import (
	  "github.com/turnerbenjamin/querystack/querymodel"
	"github.com/turnerbenjamin/heterogen_portal/internal/icons"
	"github.com/turnerbenjamin/heterogen_portal/internal/tables"
	"github.com/turnerbenjamin/heterogen_portal/internal/templates/components"
)


templ AddTableColumnsNestedSidebar[T querymodel.TableModel](
    icons *icons.IconSet,
    tableData tables.TableData[T],
){
    @components.SidebarContent(
        icons,
        components.SidebarConfig{
            Id: "add-columns-sidebar",
            Title: "Add Columns",
            CloseHandler: "hg.editColumns.closeAddColumnsSidebar",
        },
        addTableColumnsNestedSidebarContent(
            icons,
            tableData,
        ),
    )
}

templ addTableColumnsNestedSidebarContent[T querymodel.TableModel](
    icons *icons.IconSet,
    tableData tables.TableData[T],
){
    <form
        id="add-columns-form" 
        onsubmit="hg.editColumns.addColumns(event)"
    >
        <div id="add-columns-options" class="option-group mt-7 mb-7">
        for _, column := range tableData.TableDefinition.MainGridColumns{
            {{
                hiddenClass := "";
                _, doHide := tableData.Query.SelectQuery.ColumnSet[column.Path]
                if doHide{
                    hiddenClass = "hidden"
                }
            
            }}
            <div data-column-path={column.Path} class={"option-group-item " + hiddenClass}>
            <input type="checkbox" id={"column-selector-" + column.DisplayName} name={column.DisplayName} value={column.Path}/>
            <label for={"column-selector-" + column.DisplayName}>{column.DisplayName}</label>
            </div>
        }
        </div>
        <button 
            type="submit"
            onclick="hg.editColumns.addColumns(event)"
        >
            add
        </button>
    </form>
}